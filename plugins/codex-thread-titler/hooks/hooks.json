{
  "description": "Append three task-title choices only for a confirmed new task and capture them without continuing the turn.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/thread_titler_hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking title eligibility"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/thread_titler_hook.py\"",
            "timeout": 5,
            "statusMessage": "Preparing title choices"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/thread_titler_hook.py\"",
            "timeout": 5,
            "statusMessage": "Saving title choices"
          }
        ]
      }
    ]
  }
}
